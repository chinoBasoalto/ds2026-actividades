generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Libro {
  id      Int    @id @default(autoincrement())
  titulo  String
  autorId Int
  anio    Int
}

model Autor {
  id           Int    @id @default(autoincrement())
  nombre       String
  nacionalidad String
}
