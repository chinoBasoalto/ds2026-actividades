generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  ADMIN
  CLIENTE
}

model Usuario {
  id           Int    @id @default(autoincrement())
  email        String @unique
  passwordHash String
  nombre       String
  rol          Rol    @default(CLIENTE)
}

model Autor {
  id           Int     @id @default(autoincrement())
  nombre       String
  nacionalidad String
  libros       Libro[]
}

model Categoria {
  id     Int     @id @default(autoincrement())
  nombre String  @unique
  libros Libro[]
}

model Libro {
  id         Int         @id @default(autoincrement())
  titulo     String
  anio       Int
  autorId    Int
  autor      Autor       @relation(fields: [autorId], references: [id])
  categorias Categoria[]
}
